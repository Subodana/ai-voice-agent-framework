# Copy to .env and fill in. Never commit .env.

# --- Claude (conversation + call summaries) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low = fastest replies on a phone line; medium for harder conversations
CLAUDE_EFFORT=low

# --- Admin console / API (required when the server is reachable from the internet) ---
ADMIN_TOKEN=

# --- Twilio (only needed for real phone calls; the browser simulator works without it) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Default outbound caller ID (a Twilio number you own); a profile can override it
TWILIO_FROM_NUMBER=
# Public HTTPS URL Twilio can reach, e.g. your ngrok or Render URL
PUBLIC_BASE_URL=
# Real outbound dials are REFUSED unless the number is listed here (comma-separated, E.164)
OUTBOUND_TEST_NUMBERS=
# ConversationRelay voice (leave TTS_VOICE empty for the provider default)
TTS_PROVIDER=ElevenLabs
TTS_VOICE=

# --- CRM webhook signing secrets (names referenced by each profile's crm.secret_env) ---
DENTAL_WEBHOOK_SECRET=change-me-dental
SOLAR_WEBHOOK_SECRET=change-me-solar

# --- Cal.com (only for profiles with calendar.provider = "calcom") ---
CALCOM_API_KEY=
SOLAR_CALCOM_API_KEY=

# --- Storage ---
SQLITE_PATH=data/voice.db
DEFAULT_PROFILE=bright-smile-dental
WEBHOOK_MAX_ATTEMPTS=6

# Where the server reaches itself (used for the built-in mock CRM webhook URL '/mock-crm/webhook')
SELF_URL=http://127.0.0.1:8000
